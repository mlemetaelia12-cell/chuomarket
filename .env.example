# Neon serverless PostgreSQL connection string (server-side only)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional separate connection used only by Drizzle migration commands.
# Never run migrations against production until reviewed and approved.
MIGRATION_DATABASE_URL=

BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
BETTER_AUTH_URL=http://localhost:3000

# Cloudflare R2 (server-only credentials)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# A different, private (not publicly accessible) bucket for Notes & Past Papers PDFs.
# Must be a separate private bucket from R2_BUCKET_NAME.
R2_PRIVATE_BUCKET_NAME=
R2_PUBLIC_URL=

# Pesapal API 3.0 — sandbox credentials (server-side only)
PESAPAL_ENV=sandbox
PESAPAL_CONSUMER_KEY=
PESAPAL_CONSUMER_SECRET=
# Public HTTPS origin used for callback and IPN registration
APP_BASE_URL=http://localhost:3000

# Required to authorize the scheduled hardening cleanup endpoint
CRON_SECRET=replace-with-a-long-random-secret
